{
  "name": "skillsync-nexus-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Industry-Academia-Student Skill Ecosystem",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "start": "node server/src/index.js",
    "build": "npm run build --prefix client",
    "build:server": "npm install --prefix server",
    "start:server": "npm run start --prefix server",
    "test": "node server/test-api.js",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
